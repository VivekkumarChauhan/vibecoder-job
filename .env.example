# ─── Groq API (Free Tier) ───────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── HuggingFace (pyannote diarization) ──────────────────────────────────────────
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ─── Tesseract OCR (Optional) ──────────────────────────────────────────────────
# On Windows: set path to tesseract.exe if not on system PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ─── Pipeline Settings ──────────────────────────────────────────────────────────
CACHE_DIR=./cache
LOG_LEVEL=INFO
LOG_FORMAT=console

# ─── Groq budget (max API calls per pipeline run) ──────────────────────────────
GROQ_BUDGET=50
